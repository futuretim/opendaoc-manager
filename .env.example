# ---------------------------------------------------------------------------
# OpenDAoC Manager — environment template
# Copy to .env and fill in. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# ---- Manager API ----------------------------------------------------------
API_PORT=4000
# Comma-separated list of origins allowed to call the API (the web SPA).
CORS_ORIGIN=http://localhost:5173
# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-please-generate-a-long-random-value
# Cookies only sent over HTTPS when true (set true in production).
COOKIE_SECURE=false
NODE_ENV=development

# ---- OpenDAoC game database (EXTERNAL — read/write, never migrated) --------
GAME_DB_HOST=127.0.0.1
GAME_DB_PORT=3306
GAME_DB_USER=opendaoc
GAME_DB_PASSWORD=
GAME_DB_NAME=opendaoc

# ---- Manager database (owned by this app — staff users, audit log) ---------
MANAGER_DB_HOST=127.0.0.1
MANAGER_DB_PORT=3306
MANAGER_DB_USER=opendaoc_manager
MANAGER_DB_PASSWORD=
MANAGER_DB_NAME=opendaoc_manager

# ---- Web SPA (build-time) --------------------------------------------------
# Base URL the SPA uses to reach the API.
VITE_API_BASE_URL=http://localhost:4000/api/v1
